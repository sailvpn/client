# JWT Authentication Example Configuration
# This example shows how to configure the proxy client to automatically
# acquire and renew JWT tokens from the remote server

# Remote server connection
params.remoteHost=your-server.com
params.remotePort=443

# Local proxy ports
params.localPort=2080
params.httpPort=9999

# Enable JWT authentication
params.crypto=JWT

# Option 1: Automatic token acquisition with username/password (RECOMMENDED)
# The client will automatically acquire a JWT token at startup and renew it periodically
params.username=alice
params.password=SecurePassword123!

# Token expiration (default: 43200 = 30 days)
params.tokenExpirationMinutes=43200

# Automatic token renewal (default: true)
params.tokenRenewalEnabled=true

# Token renewal interval in minutes (default: 10 minutes)
# The client will renew the token every 10 minutes to ensure fresh tokens
params.tokenRenewalIntervalMinutes=10

# Option 2: Manual token configuration (alternative to username/password)
# Use this if you prefer to manually manage tokens
# params.jwtToken=eyJhbGciOiJIUzI1NiJ9.eyJpZCI6ImExYjJjM2Q0...
# params.tokenRenewalEnabled=true  # Still enable renewal using the current token

# Note: If both username/password and jwtToken are provided, username/password takes precedence

