# JWT Authentication Example Configuration
# This example shows how to configure the proxy client for JWT token management

# Remote server connection
params.remoteHost=your-server.com
params.remotePort=443

# Local proxy ports
params.localPort=2080
params.httpPort=9999

# Enable JWT authentication
params.crypto=JWT

# ===== OPTION 1: AUTOMATIC MODE (Single User/Device) =====
# The client will automatically acquire and renew JWT tokens
params.tokenMode=auto
params.username=alice
params.password=SecurePassword123!

# Token settings (automatic mode)
params.tokenExpirationMinutes=43200        # 30 days (default)
params.tokenRenewalEnabled=true            # Enable auto-renewal (default)
params.tokenRenewalIntervalMinutes=10      # Renew every 10 minutes (default)

# ===== OPTION 2: MANUAL MODE (Multiple Devices/Family Sharing) =====
# Uncomment these lines to use manual mode instead
# params.tokenMode=manual
# params.jwtToken=eyJhbGciOiJIUzI1NiJ9.eyJpZCI6ImExYjJjM2Q0...
#
# Manual mode:
# - No auto-renewal (prevents disrupting other devices)
# - Same token can be shared across unlimited devices
# - Perfect for family sharing
# - Update token manually before expiration

